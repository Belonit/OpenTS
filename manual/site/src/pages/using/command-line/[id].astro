---
import TombstoneDetail from '../../../components/TombstoneDetail.astro';
import { removedLaunchOptions } from '../../../lib/command-line';
import { commandRoute, launchOptions } from '../../../lib/commands';
import { type TombstoneRecord } from '../../../lib/data';
import { requireRouteTail, withBase } from '../../../lib/paths';

export async function getStaticPaths() {
	// Each option once had a page of its own here, and that route now opens its entry.
	const active = launchOptions().map((record) => ({
		params: { id: record.route_id },
		props: { kind: 'active' as const, destination: commandRoute(record) },
	}));
	const removed = removedLaunchOptions().map((record) => ({
		params: { id: requireRouteTail(record.route, `Command tombstone ${record.id}`) },
		props: { kind: 'removed' as const, record },
	}));
	return [...active, ...removed];
}

type Props =
	| { kind: 'active'; destination: string }
	| { kind: 'removed'; record: TombstoneRecord };
const props = Astro.props as Props;
const redirect = props.kind === 'active' ? withBase(props.destination) : undefined;
if (redirect) return Astro.redirect(redirect, 301);
---

{props.kind === 'removed' && <TombstoneDetail record={props.record} />}
